  m_Script: {fileID: 11500000, guid: 50b81fff0b03cbc4e9dcc4632df66d65, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Jumpline::Jumpline.UI.LocalizedText
  key: 'Your runner moves forward on its own.


    HOLD the screen to charge your jump.

    RELEASE to jump.


    A short press is a small hop, a long press is a big jump. Read the obstacles ahead and time your release.


    Hit an obstacle and the run ends. Retry instantly and beat the level!'
--- !u!114 &961042464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
