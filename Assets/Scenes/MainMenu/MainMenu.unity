  legends:
  - level: 1
    nameKey: TEPEGOZ
    regionKey: DIYARBAKIR
    storyKey: A one-eyed giant from the Dede Korkut tales. He hurls whatever he grabs and never stops chasing.
    weaknessKey: EYE
    rarity: 0
    stats: {x: 5, y: 2, z: 1}
    portrait: {fileID: 21300000, guid: 0172a541e21d60545a7435970bbe0eec, type: 3}
  - level: 2
    nameKey: SHAHMARAN
    regionKey: MARDIN
    storyKey: The wise serpent queen of the underground. She slips between lanes like water.
    weaknessKey: LIGHT
    rarity: 0
    stats: {x: 3, y: 4, z: 5}
    portrait: {fileID: 21300000, guid: 8f09e07c8f8763c4a8d133fa857e86cb, type: 3}
  - level: 3
    nameKey: HUMBABA
    regionKey: HASANKEYF
    storyKey: Ancient guardian of the cedar forest. Throws often but turns slowly.
    weaknessKey: SLOW TURNS
    rarity: 1
    stats: {x: 4, y: 2, z: 3}
    portrait: {fileID: 21300000, guid: 56201f838d518e444907fdeee6ca24aa, type: 3}
  - level: 4
    nameKey: STONE GUARDIAN
    regionKey: SANLIURFA
    storyKey: A stone guardian awakened at Gobeklitepe. Too heavy to slide, too tough to fall quickly.
    weaknessKey: CAN'T SLIDE
    rarity: 1
    stats: {x: 5, y: 1, z: 2}
    portrait: {fileID: 21300000, guid: 538322930b6f06e4fa9d5011fa01c77f, type: 3}
  - level: 5
    nameKey: VAN LAKE MONSTER
    regionKey: VAN
    storyKey: The shadow beneath Lake Van. Slippery and hard to follow.
    weaknessKey: SHALLOW WATER
    rarity: 2
    stats: {x: 4, y: 4, z: 3}
    portrait: {fileID: 21300000, guid: 60a0b64402a14c1419df745c393e55e2, type: 3}
  - level: 6
    nameKey: KARAKONCOLOS
    regionKey: KARS
    storyKey: A hairy winter demon of the snowy nights. Fast and full of tricks.
    weaknessKey: DAWN
    rarity: 2
    stats: {x: 3, y: 5, z: 4}
    portrait: {fileID: 21300000, guid: ea322ea9971c260419dbb5e98de51492, type: 3}
  - level: 7
    nameKey: LAMASSU
    regionKey: ???
    storyKey: A winged bull guardian with a human face. It glides over the alleys.
    weaknessKey: WINGS
    rarity: 3
    stats: {x: 4, y: 4, z: 4}
    portrait: {fileID: 21300000, guid: 464ce58f53bc280438e13b593efac496, type: 3}
  - level: 8
    nameKey: THE DRAGON
    regionKey: ???
    storyKey: The last legend that escaped the book. Fire, wings and fury.
    weaknessKey: THE BOOK
    rarity: 3
    stats: {x: 5, y: 5, z: 5}
    portrait: {fileID: 21300000, guid: 284f2e1ba381a214c86b3b8f8eb4057f, type: 3}
