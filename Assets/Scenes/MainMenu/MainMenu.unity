  m_Name: 
  m_EditorClassIdentifier: Jumpline::Jumpline.UI.BookView
  legends:
  - level: 1
    nameKey: TEPEGOZ
    regionKey: DIYARBAKIR
    storyKey: A one-eyed giant from the Dede Korkut tales. He hurls whatever he grabs and never stops chasing.
    weaknessKey: EYE
    rarity: 0
    stats: {x: 5, y: 2, z: 1}
    portrait: {fileID: 21300000, guid: 8d5e42302dfdb214891b46168d0c6dd6, type: 3}
  - level: 2
    nameKey: SHAHMARAN
    regionKey: MARDIN
    storyKey: The wise serpent queen of the underground. She slips between lanes like water.
    weaknessKey: LIGHT
    rarity: 0
    stats: {x: 3, y: 4, z: 5}
    portrait: {fileID: 21300000, guid: 6d3ef039ecd60434da877426576e964a, type: 3}
  - level: 3
    nameKey: HUMBABA
    regionKey: HASANKEYF
    storyKey: Ancient guardian of the cedar forest. Throws often but turns slowly.
    weaknessKey: SLOW TURNS
    rarity: 1
    stats: {x: 4, y: 2, z: 3}
    portrait: {fileID: 21300000, guid: 79eaa80fd32d4804db40d7e13067c345, type: 3}
  - level: 4
    nameKey: STONE GUARDIAN
    regionKey: SANLIURFA
    storyKey: A stone guardian awakened at Gobeklitepe. Too heavy to slide, too tough to fall quickly.
    weaknessKey: CAN'T SLIDE
    rarity: 1
    stats: {x: 5, y: 1, z: 2}
    portrait: {fileID: 21300000, guid: 9ebaeb66f9ac0d54783287053d5d5ed8, type: 3}
  - level: 5
    nameKey: VAN LAKE MONSTER
    regionKey: VAN
    storyKey: The shadow beneath Lake Van. Slippery and hard to follow.
    weaknessKey: SHALLOW WATER
    rarity: 2
    stats: {x: 4, y: 4, z: 3}
    portrait: {fileID: 21300000, guid: f7fd73a34cc37aa4ca75c9c2c8de3a22, type: 3}
  - level: 6
    nameKey: KARAKONCOLOS
    regionKey: KARS
    storyKey: A hairy winter demon of the snowy nights. Fast and full of tricks.
    weaknessKey: DAWN
    rarity: 2
    stats: {x: 3, y: 5, z: 4}
    portrait: {fileID: 21300000, guid: cf910a374746157409c20913206598c4, type: 3}
  - level: 7
    nameKey: LAMASSU
    regionKey: ???
    storyKey: A winged bull guardian with a human face. It glides over the alleys.
    weaknessKey: WINGS
    rarity: 3
    stats: {x: 4, y: 4, z: 4}
    portrait: {fileID: 21300000, guid: a83817b6fe2931e44a3f9ebe673863dd, type: 3}
  - level: 8
    nameKey: THE DRAGON
    regionKey: ???
    storyKey: The last legend that escaped the book. Fire, wings and fury.
    weaknessKey: THE BOOK
    rarity: 3
    stats: {x: 5, y: 5, z: 5}
    portrait: {fileID: 21300000, guid: 04354e42ebd5d584ea8ed4be8f01540b, type: 3}
